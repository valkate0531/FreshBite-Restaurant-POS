# Copy this file to .env before starting Docker Compose.
ODOO_VERSION=18.0
PSQL_VERSION=16
PYTHON_VERSION=3.12
OS_VARIANT=slim-bookworm
WKHTMLTOX_VERSION=0.12.6.1-3

POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=change-this-password
ADMIN_PASSWORD=change-this-master-password

PIP_AUTO_INSTALL=1
UPGRADE_ODOO=0
RUN_TESTS=0
WITHOUT_TEST_TAGS=0
TEST_ENABLE=False

ODOO_BASEPATH=/opt/odoo
ODOO_DATA_DIR=/var/lib/odoo/data
ODOO_LOGS_DIR=/var/lib/odoo/logs
ODOO_EXTRA_ADDONS=/mnt/extra-addons
ODOO_RC=/etc/odoo/odoo.conf
ODOO_CMD=${ODOO_BASEPATH}/odoo-bin

HTTP_INTERFACE=0.0.0.0
HTTP_PORT=8069
WORKERS=0
PROXY_MODE=False
LIST_DB=True
SERVER_WIDE_MODULES=base,web
WITHOUT_DEMO=True
DBFILTER=.*
DB_SSLMODE=prefer
DB_TEMPLATE=template1
LOG_LEVEL=info
LOG_HANDLER=:INFO
MAX_CRON_THREADS=2
